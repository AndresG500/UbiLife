# =============================================================
# .env para desarrollo local con Docker
# Copia este archivo como Backend/.env antes de iniciar el backend.
# =============================================================

# MongoDB en contenedor Docker (mismo que el local)
MONGO_URI=mongodb://localhost:27017/UbiLife

# JWT — Pídele esta clave a tu compañero (debe ser la misma en ambos lados)
SECRET_KEY=PEDIR_AL_COMPAÑERO
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MQTT — Pídele las credenciales a tu compañero
# (el backend funciona sin esto, solo no recibirá GPS en tiempo real)
MQTT_HOST=
MQTT_PORT=8883
MQTT_USER=
MQTT_PASS=
