# =============================================================
# Plantilla de variables de entorno para Railway / Docker
# Copia este archivo como Backend/.env para desarrollo local.
# En Railway configura cada variable en el panel de Variables.
# =============================================================

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=UbiLife

# JWT
SECRET_KEY=GENERAR_CON_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cifrado de campos sensibles — generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# MQTT (HiveMQ Cloud)
MQTT_HOST=
MQTT_PORT=8883
MQTT_USER=
MQTT_PASS=
MQTT_CLIENT_ID=

# Admin
ADMIN_SETUP_KEY=

# Producción
ENVIRONMENT=production
TRUST_PROXY=1
ALLOWED_ORIGINS=https://tu-dominio.com
